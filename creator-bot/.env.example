# העתק את הקובץ הזה ל-.env ומלא את הערכים (בלי מרכאות).

# --- חובה ---
# הטוקן שמקבלים מ-@BotFather בטלגרם
TELEGRAM_BOT_TOKEN=

# --- זמנים והעדפות (אפשר להשאיר כמו שזה) ---
TIMEZONE=Asia/Jerusalem
# מתי לשלוח את המשימות של הבוקר ואת הצ'ק-אין של הערב
MORNING_TIME=09:00
EVENING_TIME=20:30
# באיזה יום מתחיל השבוע (sunday / monday)
WEEK_START=sunday
# יעד העלאות שבועי התחלתי (אפשר לשנות מתוך הבוט: 🎯 יעדים)
UPLOADS_PER_WEEK=1
# איפה לשמור את הנתונים
DB_PATH=data/creator_bot.db
# לא חובה: מזהה הצ'אט שלך. אם ריק – מי ששולח /start ראשון הופך לבעלים
OWNER_CHAT_ID=
# לא חובה: מודולים לכיבוי, מופרדים בפסיק (למשל: ideas,routines)
DISABLED_MODULES=

# --- נתוני ערוץ מיוטיוב (לא חובה) ---
# מפתח API של YouTube Data API v3 (ראה README)
YOUTUBE_API_KEY=
# מזהה הערוץ (UC...) או ה-handle שלו (@mychannel)
YOUTUBE_CHANNEL=

# --- גוגל דרייב (לא חובה) ---
# OAuth client מסוג Desktop app (ראה README), ואז:  python -m creator_bot.tools.google_auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- עוזר בינה מלאכותית באפליקציה למחשב (לא חובה) ---
# אפשר גם להזין את המפתחות מתוך האפליקציה (מסך "עוזר" או ההגדרות).
# מפתח חינם של Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# מפתח API של Anthropic (Claude, בתשלום לפי שימוש)
ANTHROPIC_API_KEY=
